            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isValidId(workspaceId) && isValidId(regId) &&
          (existing().ownerId == request.auth.uid || isAdmin());
      }
    }
  }
}
