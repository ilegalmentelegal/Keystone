        data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 128 &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120 &&
        (!('employeePosition' in data) || data.employeePosition in ['Operador', 'Segundo', 'Líder']) &&
        data.shift in ['Shift A (Mon-Wed)', 'Shift B (Thu-Sat)', 'Mon-Thu'] &&
        data.trainerId in ['trainer_a', 'trainer_b'] &&
